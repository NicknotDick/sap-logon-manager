# ---- 构建产物 / 发布产物（体积巨大，且含单文件 exe）----
**/bin/
**/obj/
publish/
# dist 全部忽略：exe 通过 GitHub Release 附件分发（>50MB 无法走 git push）
dist/
*.user
.vs/
*.suo

# ---- 运行数据 / 日志（可能含个人信息）----
data/
logs/
*.log
*.lnk

# ---- 本机工具与缓存 ----
.workbuddy/
*.tmp

# ---- 旧 Python 原型打包残留 ----
py/__pycache__/
**/__pycache__/
*.pyc
build/py/
SAP登录器-简易版.exe
*.pkg

# ---- 本机注册表备份（含机器信息）----
registry-backup-*.txt

# ---- 本地实验/探测脚本（含内网信息，不入库）----
build/exp*
tools/WinProbe/
py/
docs/screenshots/

# 含本机路径的临时脚本
build/read_lnk.py

# ---- 分发产物（exe 超 50MB，走 GitHub Release 附件分发）----
release/
build/out-*/
docs/
release-parts/
