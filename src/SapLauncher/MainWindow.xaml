<Window x:Class="SapLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="1140" Height="740" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Brush.Window}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="Assets/app.ico">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="262" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="12,0,10,0" TextChanged="OnSearchChanged" />
                <TextBlock Text="{DynamicResource List.Search}" Margin="13,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SyncButton" Content="{DynamicResource Btn.Sync}" Style="{StaticResource Btn.Primary}"
                        Click="OnSyncClick" ToolTip="F5" Margin="0,0,10,0" />
                <Button x:Name="BatchButton" Content="{DynamicResource Btn.Batch}" Click="OnBatchClick"
                        Margin="0,0,10,0" IsEnabled="False" />
                <Button Content="{DynamicResource Btn.Add}" Click="OnAddClick" Margin="0,0,14,0" />
                <ComboBox x:Name="SortBox" Width="128" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="{DynamicResource Sort.Favorite}" Tag="Favorite" />
                    <ComboBoxItem Content="{DynamicResource Sort.Name}" Tag="Name" />
                    <ComboBoxItem Content="{DynamicResource Sort.Recent}" Tag="Recent" />
                    <ComboBoxItem Content="{DynamicResource Sort.Custom}" Tag="Custom" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="8"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavAll" Style="{StaticResource NavButton}" GroupName="nav" Tag="≡"
                                     Content="{DynamicResource Nav.All}" IsChecked="True" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavFav" Style="{StaticResource NavButton}" GroupName="nav" Tag="★"
                                     Content="{DynamicResource Nav.Favorites}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavProd" Style="{StaticResource NavButton}" GroupName="nav" Tag="▲"
                                     Content="{DynamicResource Nav.Production}" Checked="OnNavChanged" />

                        <TextBlock Text="{DynamicResource Nav.Groups}" Margin="10,16,0,6" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                            Padding="6,8,6,2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Btn.Settings}" Style="{StaticResource Btn.Link}"
                                    Click="OnSettingsClick" />
                            <TextBlock Text="·" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0" VerticalAlignment="Center" />
                            <Button Content="{DynamicResource Settings.About}" Style="{StaticResource Btn.Link}"
                                    Click="OnAboutClick" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="GroupPanel" />
                            <Button Content="{DynamicResource Nav.NewGroup}" Style="{StaticResource Btn.Link}"
                                    HorizontalAlignment="Left" Margin="10,6,0,0" Click="OnNewGroupClick" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 列表区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" CornerRadius="10"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <ListBox x:Name="SystemList" ItemsSource="{Binding}" SelectionMode="Single"
                                 MouseDoubleClick="OnListDoubleClick" Margin="2"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="OnContextMenuOpened">
                                    <MenuItem x:Name="MenuLogin" Header="{DynamicResource Ctx.Login}" InputGestureText="Enter" Click="OnCtxLogin" />
                                    <MenuItem x:Name="MenuCred" Header="{DynamicResource Ctx.Credential}" Click="OnCtxCredential" />
                                    <MenuItem x:Name="MenuEdit" Header="{DynamicResource Ctx.Edit}" Click="OnCtxEdit" />
                                    <Separator />
                                    <MenuItem x:Name="MenuCopy" Header="{DynamicResource Ctx.CopyInfo}" Click="OnCtxCopyInfo" />
                                    <MenuItem x:Name="MenuSap" Header="{DynamicResource Ctx.SapFile}" Click="OnCtxExportSap" />
                                    <MenuItem x:Name="MenuScripts" Header="{DynamicResource Ctx.Scripts}" Click="OnCtxScripts" />
                                    <Separator />
                                    <MenuItem x:Name="MenuFav" Header="{DynamicResource Ctx.Favorite}" Click="OnCtxFavorite" />
                                    <MenuItem x:Name="MenuGroup" Header="{DynamicResource Ctx.MoveGroup}" Click="OnCtxMoveGroup" />
                                    <MenuItem x:Name="MenuClearNew" Header="{DynamicResource Ctx.ClearNew}" Click="OnCtxClearNew" />
                                    <Separator />
                                    <MenuItem x:Name="MenuDelete" Header="{DynamicResource Ctx.Delete}" Click="OnCtxDelete" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="58">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <Border Grid.Column="1" Width="42" Height="20" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EnvLabel}" Value="PRD">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EnvLabel}" Value="QAS">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EnvLabel}" Value="DEV">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EnvLabel}" FontSize="10" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EnvLabel}" Value="PRD">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EnvLabel}" Value="QAS">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EnvLabel}" Value="DEV">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                                <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="3" Padding="5,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="NEW" FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Accent}" />
                                                </Border>
                                                <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="3" Padding="5,1"
                                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="失效" FontSize="9" Foreground="{DynamicResource Brush.Danger}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Sid}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                                                <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <TextBlock Text="{Binding ConnectionText}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AccountLine}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.Accent}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AccountLine}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <TextBlock Text="{Binding LoginText}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding ClientText}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" ToolTip="{DynamicResource Editor.Client}" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Probe}" Value="Online">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Probe}" Value="Offline">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Probe}" Value="Probing">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </StackPanel>

                                        <Button Grid.Column="5" Style="{StaticResource Btn.Ghost}" Width="26" Height="26"
                                                Click="OnToggleFavorite" ToolTip="{DynamicResource Ctx.Favorite}">
                                            <TextBlock Text="★" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <Button Grid.Column="6" Content="{DynamicResource Btn.Login}" Style="{StaticResource Btn.Ghost}"
                                                Foreground="{DynamicResource Brush.Accent}" Click="OnRowLogin"
                                                HorizontalAlignment="Right" Margin="0,0,6,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态 -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource List.Empty}" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource List.EmptyTip}" FontSize="12" Margin="0,8,0,16"
                                       Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
                            <Button Content="{DynamicResource Btn.Sync}" Style="{StaticResource Btn.Primary}"
                                    HorizontalAlignment="Center" Click="OnSyncClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 批量操作条 -->
                <Border x:Name="BatchBar" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="14,9"
                        Background="{DynamicResource Brush.AccentSoft}" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock x:Name="BatchText" VerticalAlignment="Center" FontSize="12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Btn.ClearSelection}" Style="{StaticResource Btn.Ghost}"
                                    Click="OnClearSelection" Margin="0,0,8,0" Height="28" />
                            <Button x:Name="LoginSelectedButton" Style="{StaticResource Btn.Primary}" Height="28"
                                    Click="OnLoginSelected" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Grid Grid.Row="2" Margin="20,10,20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GuiText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Text="  |  " FontSize="11" Foreground="{DynamicResource Brush.Border}" />
                <TextBlock x:Name="SyncText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SelectionText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Text="  |  " FontSize="11" Foreground="{DynamicResource Brush.Border}" />
                <TextBlock x:Name="LockText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
        </Grid>

        <!-- 轻提示 -->
        <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,22,44" Visibility="Collapsed"
                Opacity="0" MaxWidth="560">
            <TextBlock x:Name="ToastText" FontSize="12.5" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
