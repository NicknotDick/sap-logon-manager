<Window x:Class="SapLauncher.Views.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Batch.Title}"
        Width="660" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Batch.Title}" Style="{StaticResource Text.Title}" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" CornerRadius="9"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <ListBox x:Name="ItemsList" Margin="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Manual">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyButton" Content="{DynamicResource Batch.CopyReport}" Click="OnCopyReport"
                    Margin="0,0,10,0" IsEnabled="False" />
            <Button x:Name="StopButton" Content="{DynamicResource Batch.Stop}" Click="OnStop" Margin="0,0,10,0"
                    IsEnabled="False" />
            <Button x:Name="StartButton" Content="{DynamicResource Batch.Start}" Style="{StaticResource Btn.Primary}"
                    Click="OnStart" Margin="0,0,10,0" />
            <Button Content="{DynamicResource Btn.Close}" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
