<Window x:Class="SapLauncher.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SapLauncher.Views"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False">
    <Border Padding="22,20">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="LabelText" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
            <TextBox x:Name="ValueBox" />
            <views:PasswordField x:Name="SecretBox" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource Btn.Cancel}" Click="OnCancel" Margin="0,0,10,0" />
                <Button Content="{DynamicResource Btn.OK}" Style="{StaticResource Btn.Primary}" Click="OnOk" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
