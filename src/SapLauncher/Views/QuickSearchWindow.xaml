<Window x:Class="SapLauncher.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Margin="18" Background="{DynamicResource Brush.Surface}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBox x:Name="SearchInput" Height="42" FontSize="15" Padding="14,0" TextChanged="OnSearchChanged" />
                <TextBlock Text="{DynamicResource Quick.Placeholder}" Margin="15,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ListBox x:Name="Results" Grid.Row="1" Margin="0,10,0,0" MouseDoubleClick="OnDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding EnvLabel}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Sid}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="10,0,6,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="{DynamicResource Quick.Empty}" FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <TextBlock Grid.Row="2" Text="{DynamicResource Quick.Hint}" FontSize="11" Margin="2,10,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}" />
        </Grid>
    </Border>
</Window>
