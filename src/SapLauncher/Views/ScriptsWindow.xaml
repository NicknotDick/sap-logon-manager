<Window x:Class="SapLauncher.Views.ScriptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Script.Title}"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Script.Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{DynamicResource Script.Hint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" CornerRadius="9"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{DynamicResource Script.New}" Click="OnNew" Height="28" MinWidth="0" Padding="10,0" />
                        <Button Content="{DynamicResource Script.Import}" Click="OnImport" Height="28" MinWidth="0" Padding="10,0" Margin="6,0,0,0" />
                        <Button Content="{DynamicResource Btn.Delete}" Click="OnDelete" Height="28" MinWidth="0" Padding="10,0" Margin="6,0,0,0" />
                    </StackPanel>
                    <ListBox x:Name="ScriptList" SelectionChanged="OnSelectScript" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" CornerRadius="9"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Script.Name}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                    <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,0,0,10" />

                    <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5" Height="Auto" MinHeight="180"
                             Padding="10,8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource Btn.Save}" Style="{StaticResource Btn.Primary}" Click="OnSave" Height="30" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Script.Run}" Click="OnRun" Height="30" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Script.Bind}" Click="OnBind" Height="30" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Script.Unbind}" Click="OnUnbind" Height="30" />
                    </StackPanel>

                    <TextBlock x:Name="BoundText" Grid.Row="4" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn.Close}" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
