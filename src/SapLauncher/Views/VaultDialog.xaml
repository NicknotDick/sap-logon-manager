<Window x:Class="SapLauncher.Views.VaultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SapLauncher.Views"
        Title="{DynamicResource Unlock.Title}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Padding="26,22" >
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="{DynamicResource Unlock.Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="HintText" Text="{DynamicResource Unlock.Hint}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextDim}" FontSize="12" Margin="0,8,0,18" />

            <StackPanel x:Name="CurrentPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Unlock.Password}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />
                <views:PasswordField x:Name="CurrentBox" />
            </StackPanel>

            <TextBlock x:Name="MainLabel" Text="{DynamicResource Unlock.Password}" FontSize="12"
                       Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />
            <views:PasswordField x:Name="MainBox" />
            <Button x:Name="RecoverButton" Content="{DynamicResource Unlock.RecoverWindows}"
                    Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="Collapsed" Click="OnRecoverWithWindows" />

            <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Unlock.Confirm}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />
                <views:PasswordField x:Name="ConfirmBox" />
            </StackPanel>

            <CheckBox x:Name="RememberBox" Content="{DynamicResource Unlock.Remember}" Margin="0,16,0,0" IsChecked="True" />

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{DynamicResource Btn.Cancel}" Click="OnCancel" Margin="0,0,10,0" MinWidth="82" />
                <Button x:Name="OkButton" Content="{DynamicResource Unlock.Unlock}" Style="{StaticResource Btn.Primary}"
                        Click="OnOk" MinWidth="96" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
