<Window x:Class="SapLauncher.Views.GroupPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False"
        Title="{DynamicResource Ctx.MoveGroup}">
    <Border Padding="22,20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Ctx.MoveGroup}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Editor.Group}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
            <ComboBox x:Name="GroupCombo" IsEditable="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource Btn.Cancel}" Click="OnCancel" Margin="0,0,10,0" />
                <Button Content="{DynamicResource Btn.OK}" Style="{StaticResource Btn.Primary}" Click="OnOk" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
