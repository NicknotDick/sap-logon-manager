<Window x:Class="SapLauncher.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SapLauncher.Views"
        Title="{DynamicResource Import.Title}"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Import.Title}" Style="{StaticResource Text.Title}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" IsReadOnly="True" />
                <Button Grid.Column="2" Content="{DynamicResource Btn.Browse}" Click="OnBrowse" />
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="OverwriteCheck" Content="{DynamicResource Import.Overwrite}" />
                    <CheckBox x:Name="GroupsCheck" Content="{DynamicResource Import.Groups}" IsChecked="True" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Import.Password}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                    <views:PasswordField x:Name="ExportPasswordBox" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Import.Preview}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" CornerRadius="9"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,0,12">
            <ListBox x:Name="PreviewList" Margin="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="11" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,12,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Btn.Cancel}" Click="OnCancel" Margin="0,0,10,0" />
            <Button x:Name="ImportButton" Content="{DynamicResource Btn.Import}" Style="{StaticResource Btn.Primary}"
                    Click="OnImport" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
