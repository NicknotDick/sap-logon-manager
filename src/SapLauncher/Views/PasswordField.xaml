<UserControl x:Class="SapLauncher.Views.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <PasswordBox x:Name="InnerBox" />
            <TextBox x:Name="InnerPlain" Visibility="Collapsed" />
        </Grid>
        <Button x:Name="EyeButton" Grid.Column="1" Width="40" Margin="6,0,0,0"
                VerticalAlignment="Stretch" Padding="0" FontFamily="Segoe UI Emoji" FontSize="15"
                Content="&#x1F441;" ToolTip="{DynamicResource Editor.PeekPassword}" />
    </Grid>
</UserControl>
