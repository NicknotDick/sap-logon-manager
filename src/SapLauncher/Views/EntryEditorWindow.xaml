<Window x:Class="SapLauncher.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SapLauncher.Views"
        Title="{DynamicResource Editor.Title}"
        Width="720" SizeToContent="Height" MaxHeight="880" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="{DynamicResource Editor.Title}" Style="{StaticResource Text.Title}" />

                <!-- 连接信息 -->
                <StackPanel x:Name="ConnectionSection">
                    <TextBlock Text="{DynamicResource Editor.Basic}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,18,0,8" />

                    <TextBlock Text="{DynamicResource Editor.Name}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                    <TextBox x:Name="NameBox" />
                    <TextBlock Text="{DynamicResource Editor.NameHint}" Style="{StaticResource Text.Caption}" Margin="2,5,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Editor.Sid}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <TextBox x:Name="SidBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Editor.Env}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <ComboBox x:Name="EnvBox">
                                <ComboBoxItem Content="自动识别" Tag="Unknown" />
                                <ComboBoxItem Content="DEV" Tag="Dev" />
                                <ComboBoxItem Content="QAS" Tag="Qas" />
                                <ComboBoxItem Content="PRD" Tag="Prd" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Editor.Kind}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged">
                                <ComboBoxItem Content="{DynamicResource Editor.Kind.Direct}" Tag="Direct" />
                                <ComboBoxItem Content="{DynamicResource Editor.Kind.Router}" Tag="Router" />
                                <ComboBoxItem Content="{DynamicResource Editor.Kind.Lb}" Tag="LoadBalanced" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Editor.Group}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <ComboBox x:Name="GroupCombo" IsEditable="True" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Editor.Host}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <TextBox x:Name="HostBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Editor.Port}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <TextBox x:Name="PortBox" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Editor.Router}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <TextBox x:Name="RouterBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Editor.MessageServer}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                            <TextBox x:Name="MsBox" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Editor.Alias}" Style="{StaticResource Text.Caption}" Margin="0,12,0,5" />
                    <TextBox x:Name="AliasBox" />

                    <TextBlock Text="{DynamicResource Editor.Memo}" Style="{StaticResource Text.Caption}" Margin="0,12,0,5" />
                    <TextBox x:Name="MemoBox" Style="{StaticResource Input.Multiline}" MinHeight="60" />
                </StackPanel>

                <!-- 凭据 -->
                <TextBlock Text="{DynamicResource Editor.Credential}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,20,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Editor.Client}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <ComboBox x:Name="ClientBox" IsEditable="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{DynamicResource Editor.NewAccount}" Click="OnAddAccount"
                            VerticalAlignment="Bottom" Height="34" />
                </Grid>

                <!-- 账号列表：同一客户端可保存多个账号 -->
                <TextBlock x:Name="AccountCountText" Style="{StaticResource Text.Caption}" Margin="0,14,0,5" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="7" Padding="4">
                    <ListBox x:Name="AccountList" MaxHeight="132" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnAccountSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x25CF;" FontSize="8" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Editor.DefaultAccount}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SetDefaultButton" Content="{DynamicResource Editor.SetDefault}" Click="OnSetDefault"
                            Height="28" MinWidth="0" Padding="12,0" Margin="0,0,8,0" />
                    <Button x:Name="DeleteAccountButton" Content="{DynamicResource Editor.DeleteAccount}" Click="OnDeleteAccount"
                            Height="28" MinWidth="0" Padding="12,0" />
                </StackPanel>

                <TextBlock Text="{DynamicResource Editor.DisplayName}" Style="{StaticResource Text.Caption}" Margin="0,14,0,5" />
                <TextBox x:Name="RealNameBox" TextChanged="OnRealNameChanged" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Editor.User}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <TextBox x:Name="UserBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Editor.Language}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <ComboBox x:Name="LangBox">
                            <ComboBoxItem Content="ZH" />
                            <ComboBoxItem Content="EN" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Editor.Password}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <views:PasswordField x:Name="PasswordBox2" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Editor.Tcode}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <TextBox x:Name="TcodeBox" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Editor.LogonGroup}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <TextBox x:Name="LogonGroupBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{DynamicResource Editor.LoginMethod}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <ComboBox x:Name="LoginMethodBox" Height="34">
                            <ComboBoxItem Content="{DynamicResource Editor.LoginMethod.Auto}" Tag="Auto" />
                            <ComboBoxItem Content="{DynamicResource Editor.LoginMethod.CmdPw}" Tag="CmdPw" />
                            <ComboBoxItem Content="{DynamicResource Editor.LoginMethod.SapOnly}" Tag="SapOnly" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="LoginMethodHint" Style="{StaticResource Text.Caption}" Margin="24,6,0,0" TextWrapping="Wrap" />

                <CheckBox x:Name="DirectTcodeBox" Content="{DynamicResource Editor.DirectTcode}" Margin="0,14,0,0" />
                <TextBlock Text="{DynamicResource Editor.DirectTcodeHint}" Style="{StaticResource Text.Caption}"
                           Margin="24,4,0,0" TextWrapping="Wrap" />

                <CheckBox x:Name="RememberBox" Content="{DynamicResource Editor.Remember}" Margin="0,12,0,0" IsChecked="True" />

                <TextBlock x:Name="VaultHint" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource Brush.Warn}" />

                <!-- 候选线索 -->
                <StackPanel x:Name="CandidateSection" Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Editor.Candidates}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                    <StackPanel x:Name="CandidatePanel" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="12"
                           Margin="0,14,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Btn.Cancel}" Click="OnCancel" Margin="0,0,10,0" />
                <Button Content="{DynamicResource Btn.Save}" Style="{StaticResource Btn.Primary}" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
