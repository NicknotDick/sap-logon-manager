<Window x:Class="SapLauncher.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Update.Title}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Padding="24,20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Update.Title}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
            <TextBlock x:Name="PublishedText" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            <TextBlock Text="{DynamicResource Update.WhatsNew}" FontSize="12" Margin="0,16,0,6"
                       Foreground="{DynamicResource Brush.TextDim}" />
            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextDim}" LineHeight="18" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource Update.Later}" Click="OnLater" Margin="0,0,10,0" />
                <Button Content="{DynamicResource Update.View}" Style="{StaticResource Btn.Primary}"
                        Click="OnView" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
