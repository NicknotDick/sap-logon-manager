<Window x:Class="SapLauncher.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About.Title}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False">
    <Border Padding="26,22">
        <StackPanel>
            <TextBlock Text="{DynamicResource App.Title}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
            <TextBlock Text="{DynamicResource About.Author}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            <TextBlock Text="{DynamicResource About.Desc}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Foreground="{DynamicResource Brush.TextDim}" FontSize="12.5" LineHeight="20" />
            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Notice}" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextDim}" LineHeight="18" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="PathText" Style="{StaticResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource About.Disclaimer}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,14,0,0" LineHeight="17" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource Settings.Diagnostic}" Click="OnCopyDiagnostic" Margin="0,0,10,0" />
                <Button Content="{DynamicResource Btn.Close}" Style="{StaticResource Btn.Primary}" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
