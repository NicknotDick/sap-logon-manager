<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window">#FF0E1218</Color>
    <Color x:Key="Color.Surface">#FF151A22</Color>
    <Color x:Key="Color.SurfaceAlt">#FF1C232D</Color>
    <Color x:Key="Color.SurfaceHover">#FF232C38</Color>
    <Color x:Key="Color.Border">#FF2A3441</Color>
    <Color x:Key="Color.BorderStrong">#FF3A4757</Color>
    <Color x:Key="Color.Text">#FFE8EEF6</Color>
    <Color x:Key="Color.TextDim">#FF97A4B5</Color>
    <Color x:Key="Color.TextMuted">#FF6B7889</Color>
    <Color x:Key="Color.Accent">#FF2F7BE0</Color>
    <Color x:Key="Color.AccentHover">#FF3D8BEF</Color>
    <Color x:Key="Color.AccentSoft">#332F7BE0</Color>
    <Color x:Key="Color.Danger">#FFF06A5E</Color>
    <Color x:Key="Color.DangerSoft">#33F06A5E</Color>
    <Color x:Key="Color.Success">#FF4BBE7A</Color>
    <Color x:Key="Color.SuccessSoft">#334BBE7A</Color>
    <Color x:Key="Color.Warn">#FFE0A33E</Color>
    <Color x:Key="Color.WarnSoft">#33E0A33E</Color>
    <Color x:Key="Color.Selection">#FF1D2735</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FF11161D" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#CC0A0E13" />

</ResourceDictionary>
