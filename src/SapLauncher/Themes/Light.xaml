<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window">#FFF3F6FA</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFF7F9FC</Color>
    <Color x:Key="Color.SurfaceHover">#FFEDF2F8</Color>
    <Color x:Key="Color.Border">#FFD7E0EA</Color>
    <Color x:Key="Color.BorderStrong">#FFB9C6D4</Color>
    <Color x:Key="Color.Text">#FF18222E</Color>
    <Color x:Key="Color.TextDim">#FF5B6B7C</Color>
    <Color x:Key="Color.TextMuted">#FF8A97A6</Color>
    <Color x:Key="Color.Accent">#FF1F6FEB</Color>
    <Color x:Key="Color.AccentHover">#FF1A5FD0</Color>
    <Color x:Key="Color.AccentSoft">#1A1F6FEB</Color>
    <Color x:Key="Color.Danger">#FFD03B2E</Color>
    <Color x:Key="Color.DangerSoft">#1AD03B2E</Color>
    <Color x:Key="Color.Success">#FF1F8F52</Color>
    <Color x:Key="Color.SuccessSoft">#1A1F8F52</Color>
    <Color x:Key="Color.Warn">#FFAD6A00</Color>
    <Color x:Key="Color.WarnSoft">#1AAD6A00</Color>
    <Color x:Key="Color.Selection">#FFE7EFFB</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#B3F3F6FA" />

</ResourceDictionary>
